# ============================================================
# StreamHub — local.properties template
# ============================================================
# Copy this file to `local.properties` (gitignored) and fill in real values.
# Never commit `local.properties`.
#
# For CI / GitHub Actions, set the SAME values as repository secrets
# (Settings → Secrets and variables → Actions) using the env-var names
# in the right-hand column. The build script checks env vars first,
# then local.properties, then falls back to empty defaults.
#
# NOTE: Anime metadata is powered 100% by AniList GraphQL (graphql.anilist.co)
# which is public, lightning-fast, and requires ZERO API keys or client IDs.
# ============================================================

#                              local.properties key               GitHub Actions secret name
#                              ──────────────────────────────     ─────────────────────────────────────
# TMDB v3 API key (For Movies & Series metadata, posters & backdrops)
# Get a free API key at: https://www.themoviedb.org/settings/api
streamhub.tmdb_api_key=YOUR_TMDB_API_KEY_HERE                       # STREAMHUB_TMDB_API_KEY

# Master Admin Password (Optional fallback for Creator Studio unlock)
streamhub.admin_master_password=YOUR_ADMIN_PASSWORD_HERE            # STREAMHUB_ADMIN_MASTER_PASSWORD

# Community VIP Access Code (Optional fallback for permanent App Gate unlock)
streamhub.app_access_code=YOUR_VIP_ACCESS_CODE_HERE                 # STREAMHUB_APP_ACCESS_CODE
