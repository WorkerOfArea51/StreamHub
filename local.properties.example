# ============================================================
# StreamHub — local.properties template
# ============================================================
# Copy this file to `local.properties` (gitignored) and fill in real values.
# Never commit `local.properties`.
#
# For CI / GitHub Actions, set the SAME values as repository secrets
# (Settings → Secrets and variables → Actions) using the env-var names
# in the right-hand column. The build script checks env vars first,
# then local.properties, then falls back to empty defaults.
#
# If a key is missing or empty, the build still succeeds, but the
# corresponding runtime feature will degrade gracefully (e.g. TMDB
# metadata autofetch returns no results).
# ============================================================

#                              local.properties key               GitHub Actions secret name
#                              ──────────────────────────────     ─────────────────────────────────────
# TMDB v3 API key
# Get one at: https://www.themoviedb.org/settings/api
# After getting a key, REVOKE the previously leaked key
#   ec562d9f2a8a07ffb7fa3308fb5bec9c
# from your TMDB dashboard — it was committed to public git history.
streamhub.tmdb_api_key=YOUR_TMDB_API_KEY_HERE                       # STREAMHUB_TMDB_API_KEY

# MyAnimeList v2 client ID
# Register at: https://myanimelist.net/apiconfig
# Client secret is empty for public clients (PKCE flow).
streamhub.mal_client_id=YOUR_MAL_CLIENT_ID_HERE                     # STREAMHUB_MAL_CLIENT_ID
streamhub.mal_client_secret=                                        # STREAMHUB_MAL_CLIENT_SECRET

# Telegram Bot Token from @BotFather
# Required only for streaming from private Telegram channels (M4).
# Bot must be a member of the target channel with read access.
streamhub.telegram_bot_token=                                       # STREAMHUB_TELEGRAM_BOT_TOKEN

# Private Telegram channel ID (the negative number from t.me/c/<id>/...)
# Example: if URL is https://t.me/c/2633457020/7159, the ID is -1002633457020
# (Telegram private channel IDs are prefixed with -100 in Bot API.)
streamhub.telegram_channel_id=                                      # STREAMHUB_TELEGRAM_CHANNEL_ID

# Admin PIN — bcrypt hash (NOT the plaintext PIN)
# Generate with Python:
#   pip install bcrypt
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PIN', bcrypt.gensalt()).decode())"
# Or with Node:
#   npm install bcryptjs
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PIN', 12))"
#
# Default "0000" disables admin login (verification always fails).
streamhub.admin_pin_hash=0000                                       # STREAMHUB_ADMIN_PIN_HASH
