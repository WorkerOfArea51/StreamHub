<?xml version="1.0" encoding="utf-8"?>
<!--
    StreamHub Network Security Configuration
    Enforces strict HTTPS and system CA certificate verification across all endpoints.
    Eliminates brittle SPKI pin-sets that break during third-party CDN/CA rotations (GitHub, TMDB, Firebase, etc.).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Specific domain configurations ensuring strict HTTPS and system trust -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">api.github.com</domain>
        <domain includeSubdomains="true">objects.githubusercontent.com</domain>
        <domain includeSubdomains="true">api.themoviedb.org</domain>
        <domain includeSubdomains="true">image.tmdb.org</domain>
        <domain includeSubdomains="true">api.telegram.org</domain>
        <domain includeSubdomains="true">t.me</domain>
        <domain includeSubdomains="true">api.myanimelist.net</domain>
        <domain includeSubdomains="true">cdn.myanimelist.net</domain>
        <domain includeSubdomains="true">firestore.googleapis.com</domain>
        <domain includeSubdomains="true">firebase.googleapis.com</domain>
        <domain includeSubdomains="true">firebasestorage.googleapis.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Local loopback streaming proxy (TelStream architecture) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
