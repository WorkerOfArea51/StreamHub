<?xml version="1.0" encoding="utf-8"?>
<!--
    StreamHub Network Security Configuration

    Default: cleartext traffic is BLOCKED for all domains.
    All network calls must use HTTPS.

    If a specific domain truly requires cleartext in the future
    (e.g. a self-hosted test stream), add a <domain-config> block:
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="true">test.example.com</domain>
        </domain-config>

    Telegram Bot API (api.telegram.org) and Firebase (firestore.googleapis.com)
    are HTTPS-only — no exceptions needed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Telegram API domain -->
    <domain-config>
        <domain includeSubdomains="true">api.telegram.org</domain>
        <domain includeSubdomains="true">t.me</domain>
    </domain-config>

    <!-- TMDB API domain -->
    <domain-config>
        <domain includeSubdomains="true">api.themoviedb.org</domain>
        <domain includeSubdomains="true">image.tmdb.org</domain>
    </domain-config>

    <!-- Firebase / Google Services -->
    <domain-config>
        <domain includeSubdomains="true">firestore.googleapis.com</domain>
        <domain includeSubdomains="true">firebase.googleapis.com</domain>
        <domain includeSubdomains="true">securetoken.googleapis.com</domain>
    </domain-config>

    <!-- GitHub Releases (In-App Updater) -->
    <domain-config>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">api.github.com</domain>
    </domain-config>

    <!-- MyAnimeList API -->
    <domain-config>
        <domain includeSubdomains="true">api.myanimelist.net</domain>
        <domain includeSubdomains="true">cdn.myanimelist.net</domain>
    </domain-config>
</network-security-config>
