<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths for in-app APK installer.
    The APK is downloaded to cacheDir and shared via FileProvider.
-->
<paths>
    <cache-path name="apk_updates_cache" path="updates/" />
    <files-path name="apk_updates_files" path="updates/" />
    <files-path name="shared_media" path="shared/" />
</paths>
